# Copy to .env and customize. NEVER commit .env.
# Where the port is published on the server. 127.0.0.1 = only from the server itself (behind an
# HTTPS proxy, the usual setup); 0.0.0.0 = every interface (without HTTPS the password travels in plain text).
HOST=0.0.0.0
API_PORT=5178

# ── Wyze account ──────────────────────────────────────────────
# Same account as the mobile app.
WYZE_EMAIL=tu@email.com
WYZE_PASSWORD=
# Generated at https://developer-api-console.wyze.com (same account).
# KEY_ID is the short UUID-like id; API_KEY is the long key.
WYZE_KEY_ID=
WYZE_API_KEY=

# The app's user is created in the app itself: the first visit shows a signup.
