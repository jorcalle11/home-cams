# Copy to .env and customize. NEVER commit .env.
# NODE_ENV, and HOST/PORT inside the container, are set by docker-compose.yml: no need to define them here.

# ── Publishing ────────────────────────────────────────────────
# Host address and port where the app is published. With 127.0.0.1 it's only reachable from the
# server itself (the usual setup, behind an HTTPS proxy). 0.0.0.0 exposes it on every interface:
# without HTTPS the password travels in plain text.
HOST=127.0.0.1
PORT=5178

# ── Wyze account ──────────────────────────────────────────────
# Same account as the mobile app.
WYZE_EMAIL=tu@email.com
WYZE_PASSWORD=
# Generated at https://developer-api-console.wyze.com (same account).
# KEY_ID is the short UUID-like id; API_KEY is the long key.
WYZE_KEY_ID=
WYZE_API_KEY=

# ── App login (required) ──────────────────────────────────────
# The container won't start without these. Use a long password.
APP_USERNAME=admin
APP_PASSWORD=admin
# AUTH_DISABLED=true   # only if the proxy in front already asks for a login
