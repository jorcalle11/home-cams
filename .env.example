# Wyze account (same one as the mobile app)
WYZE_EMAIL=tu@email.com
WYZE_PASSWORD=tu-password
# Generated at https://developer-api-console.wyze.com
WYZE_KEY_ID=
WYZE_API_KEY=

# Server (127.0.0.1 = only reachable from this machine)
HOST=127.0.0.1
PORT=5178

# App login (required in production). Use a long password.
APP_USERNAME=admin
APP_PASSWORD=
# AUTH_DISABLED=true   # only if a proxy in front already authenticates

# API keys (one per client, web included) are created with POST /api/keys; see README.
# Origins allowed to call /api from a browser on another origin: "*" or a comma-separated list.
# Apps opened from file:// (webOS, Tizen) send the origin "null".
# CORS_ORIGINS=*
